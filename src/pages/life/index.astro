---
import BaseLayout from '@layouts/BaseLayout.astro';
import lifeData from '../../../data/life.json';

const lifeRecords = lifeData;
---

<BaseLayout title="生活记录 | Max Liu" description="Max的生活点滴 - 旅行、爱好、日常生活中的精彩瞬间">
  <section class="page-hero page-hero--life">
    <div class="container">
      <div class="page-hero__badge">📷 LIFE</div>
      <h1 class="page-hero__title">生活记录</h1>
      <p class="page-hero__desc">球场之外的Max，同样精彩</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="life-grid">
        {lifeRecords.map(record => (
          <article class="life-card">
            <a href={`/life/${record.id}/`} class="life-card__cover">
              {record.video ? (
                <>
                  <video class="life-card__cover-video" src={record.video} preload="metadata" muted playsinline />
                  <span class="life-card__play">▶</span>
                </>
              ) : (
                <img class="life-card__cover-img" src={record.photos[0]} alt={record.title} loading="lazy" />
              )}
            </a>
            <div class="life-card__content">
              <span class="life-card__category">{record.category}</span>
              <a href={`/life/${record.id}/`} class="life-card__title-link">
                <h3 class="life-card__title">{record.title}</h3>
              </a>
              <time class="life-card__date" datetime={record.date}>
                {new Date(record.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <p class="life-card__excerpt">{record.excerpt}</p>
              <div class="life-card__tags">
                {record.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .life-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .life-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .life-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .life-card__cover {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .life-card__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .life-card__cover:hover .life-card__cover-img {
    transform: scale(1.05);
  }

  .life-card__cover-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .life-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 107, 53, 0.9);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    padding-left: 3px;
    pointer-events: none;
  }

  .life-card__content {
    padding: var(--space-lg);
  }

  .life-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #818CF8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .life-card__title-link {
    text-decoration: none;
  }

  .life-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: var(--space-sm) 0;
    line-height: 1.4;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .life-card__title-link:hover .life-card__title {
    color: var(--color-accent);
  }

  .life-card__date {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-bottom: var(--space-sm);
  }

  .life-card__excerpt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .life-card__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .life-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
