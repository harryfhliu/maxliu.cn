---
import BaseLayout from '@layouts/BaseLayout.astro';
import lifeData from '../../../data/life.json';

const lifeRecords = lifeData;
---

<BaseLayout title="生活记录 | Max Liu" description="Max的生活点滴 - 旅行、爱好、日常生活中的精彩瞬间">
  <section class="page-hero page-hero--life">
    <div class="container">
      <div class="page-hero__badge">📷 LIFE</div>
      <h1 class="page-hero__title">生活记录</h1>
      <p class="page-hero__desc">球场之外的Max，同样精彩</p>
    </div>
  </section>

  <!-- Photo Grid / Life Records -->
  <section class="section">
    <div class="container">
      <div class="life-grid">
        {lifeRecords.map(record => (
          <article class="life-card">
            <div class="life-card__image">
              <div class="life-card__placeholder">
                <span class="life-card__icon">{record.category.includes('旅行') ? '🌊' : record.category.includes('生日') ? '🎂' : record.category.includes('音乐') ? '🎹' : '📸'}</span>
                <span class="life-card__photo-count">📷 {record.images}张照片</span>
              </div>
            </div>
            <div class="life-card__content">
              <span class="life-card__category">{record.category}</span>
              <h3 class="life-card__title">{record.title}</h3>
              <time class="life-card__date" datetime={record.date}>
                {new Date(record.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <p class="life-card__excerpt">{record.excerpt}</p>
              <div class="life-card__tags">
                {record.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .life-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .life-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .life-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .life-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .life-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg-elevated) 100%);
  }

  .life-card__icon {
    font-size: 3rem;
  }

  .life-card__photo-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .life-card__content {
    padding: var(--space-lg);
  }

  .life-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #818CF8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .life-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: var(--space-sm) 0;
    line-height: 1.4;
  }

  .life-card__date {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-bottom: var(--space-sm);
  }

  .life-card__excerpt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .life-card__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .life-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
