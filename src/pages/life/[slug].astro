---
import BaseLayout from '@layouts/BaseLayout.astro';
import lifeData from '../../../data/life.json';

interface LifeRecord {
  id: string;
  title: string;
  date: string;
  category: string;
  excerpt: string;
  tags: string[];
  video?: string;
  photos?: string[];
}

export function getStaticPaths() {
  return (lifeData as LifeRecord[]).map(r => ({ params: { slug: r.id } }));
}

const records = lifeData as LifeRecord[];
const { slug } = Astro.params;
const record = records.find(r => r.id === slug);

const dateStr = new Date(record!.date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${record!.title} | 生活记录 | Max Liu`}
  description={record!.excerpt}
>
  <section class="page-hero page-hero--life">
    <div class="container">
      <div class="page-hero__badge">{record!.category}</div>
      <h1 class="page-hero__title">{record!.title}</h1>
      <p class="page-hero__desc">{dateStr}</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <p class="detail-excerpt">{record!.excerpt}</p>
      <div class="detail-tags">
        {record!.tags.map(tag => <span class="tag tag--accent">{tag}</span>)}
      </div>

      {record!.video ? (
        <div class="detail-video">
          <video src={record!.video} controls playsinline preload="metadata" />
        </div>
      ) : (
        <div class="detail-photos">
          {record!.photos!.map(p => (
            <img src={p} alt={record!.title} loading="lazy" />
          ))}
        </div>
      )}

      <a href="/life/" class="back-link">← 返回生活记录</a>
    </div>
  </section>
</BaseLayout>

<style>
  .detail-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }

  .detail-tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .detail-video {
    margin: var(--space-xl) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
  }

  .detail-video video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    display: block;
  }

  .detail-photos {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
  }

  .detail-photos img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    display: block;
  }

  .back-link {
    display: inline-block;
    margin-top: var(--space-xl);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
