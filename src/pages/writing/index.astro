---
import BaseLayout from '@layouts/BaseLayout.astro';
import writingsData from '../../../data/writings.json';
import novelData from '../../../data/novel.json';

interface Writing {
  id: string;
  type: 'essay' | 'poem';
  title: string;
  date: string;
  category: string;
  excerpt?: string;
  content: string;
  tags: string[];
  award?: string;
}

const writings = writingsData as Writing[];

// 提取摘要（essay 用 excerpt，poem 用第一段）
const withSummary = writings.map(w => {
  const raw = w.excerpt || w.content.split('\n\n')[0].replace(/\n/g, ' ');
  const summary = raw.length > 80 ? raw.slice(0, 80) + '…' : raw;
  return { ...w, summary };
});

// 按日期倒序
const sorted = [...withSummary].sort((a, b) => b.date.localeCompare(a.date));

// 小说元信息（转载长篇小说《加油！棒少年》）
const novel = (novelData as any) as {
  title: string;
  subtitle: string;
  author: string;
  authorNote: string;
  cover: string;
  intro: string[];
  chapters: { n: number; title: string }[];
};
---

<BaseLayout title="文学创作 | Max Liu" description="Max的文学创作空间 - 作文与诗歌">
  <section class="page-hero page-hero--writing">
    <div class="container">
      <div class="page-hero__badge">✍️ WRITING</div>
      <h1 class="page-hero__title">文学创作</h1>
      <p class="page-hero__desc">笔尖下的世界，文字里的思考</p>
    </div>
  </section>

  <section class="section section--novel">
    <div class="container">
      <a href="/writing/novel/" class="novel-feature card">
        <div class="novel-feature__cover">
          <img src={novel.cover} alt={`《${novel.title}》封面`} />
        </div>
        <div class="novel-feature__body">
          <div class="novel-feature__meta">
            <span class="novel-feature__tag">📖 转载 · 长篇小说</span>
            <span class="novel-feature__chapters">共 {novel.chapters.length} 章</span>
          </div>
          <h2 class="novel-feature__title">《{novel.title}》</h2>
          <p class="novel-feature__subtitle">又名《{novel.subtitle}》 · {novel.author}（{novel.authorNote}）</p>
          <p class="novel-feature__desc">{novel.intro[0]}</p>
          <span class="novel-feature__more">开始阅读 →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">📚 全部作品</h2>
      <p class="section__subtitle">共 {sorted.length} 篇 · 点击阅读全文</p>

      <div class="writings-grid">
        {sorted.map(w => (
          <a href={`/writing/${w.id}/`} class="writing-card card">
            <div class="writing-card__head">
              <span class={`writing-card__type ${w.type === 'essay' ? 'writing-card__type--essay' : ''}`}>
                {w.type === 'essay' ? '🏆 获奖作文' : '📝 诗歌'}
              </span>
              <time class="writing-card__date" datetime={w.date}>
                {new Date(w.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h3 class="writing-card__title">{w.title}</h3>
            <p class="writing-card__summary">{w.summary}</p>
            <div class="writing-card__footer">
              <div class="writing-card__tags">
                {w.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              <span class="writing-card__more">阅读全文 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 小说入口卡片 */
  .section--novel {
    padding-bottom: 0;
  }

  .novel-feature {
    display: flex;
    gap: var(--space-2xl);
    align-items: center;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .novel-feature__cover {
    flex-shrink: 0;
    width: 200px;
    height: 280px;
  }

  .novel-feature__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .novel-feature__body {
    flex: 1;
    padding: var(--space-2xl) var(--space-2xl) var(--space-2xl) 0;
    min-width: 0;
  }

  .novel-feature__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .novel-feature__tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0, 212, 170, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .novel-feature__chapters {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .novel-feature__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-xs);
  }

  .novel-feature__subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .novel-feature__desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .novel-feature__more {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .novel-feature:hover .novel-feature__more {
    color: var(--color-accent);
  }

  .writings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .writing-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .writing-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .writing-card__type {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0, 212, 170, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .writing-card__type--essay {
    background: rgba(255, 215, 0, 0.15);
    color: #FFD700;
  }

  .writing-card__date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .writing-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
    line-height: 1.4;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .writing-card:hover .writing-card__title {
    color: var(--color-accent);
  }

  .writing-card__summary {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    flex: 1;
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .writing-card__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .writing-card__more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .writing-card:hover .writing-card__more {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .writings-grid {
      grid-template-columns: 1fr;
    }

    .novel-feature {
      flex-direction: column;
    }

    .novel-feature__cover {
      width: 100%;
      height: 260px;
    }

    .novel-feature__body {
      padding: var(--space-xl);
    }
  }
</style>
