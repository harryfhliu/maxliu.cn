---
import BaseLayout from '@layouts/BaseLayout.astro';
import tournamentsData from '../../../../data/tournaments.json';

interface Tournament {
  id: string;
  date: string;
  year: number;
  month: number;
  location: string;
  name: string;
  category: string | null;
  team: string;
  result: string;
  place: number | null;
  status: 'completed' | 'upcoming';
  level: string;
  note?: string;
}

const tournaments = tournamentsData as Tournament[];

const sortedTournaments = [...tournaments].sort((a, b) => {
  if (a.status !== b.status) {
    return a.status === 'completed' ? -1 : 1;
  }
  return b.date.localeCompare(a.date);
});

const placeBadge = (place: number | null, status: string) => {
  if (status === 'upcoming') return { icon: '🗓️', cls: 't-badge--upcoming', label: '即将参赛' };
  if (place === null) return { icon: '🎯', cls: 't-badge--group', label: '小组赛' };
  if (place === 1) return { icon: '🥇', cls: 't-badge--gold', label: '冠军' };
  if (place === 2) return { icon: '🥈', cls: 't-badge--silver', label: '亚军' };
  if (place === 3) return { icon: '🥉', cls: 't-badge--bronze', label: '季军' };
  if (place <= 8) return { icon: '🏅', cls: 't-badge--top8', label: `第${place}名` };
  return { icon: '📋', cls: 't-badge--plain', label: `第${place}名` };
};

const formatDate = (date: string) => {
  const [y, m] = date.split('-');
  return { y, m: `${parseInt(m)}月` };
};
---

<BaseLayout title="参赛荣誉 | Max Liu" description="Max 的完整棒球赛事荣誉记录">
  <section class="page-hero page-hero--baseball">
    <div class="container">
      <div class="page-hero__badge">⚾ BASEBALL</div>
      <h1 class="page-hero__title">参赛荣誉</h1>
      <p class="page-hero__desc">完整赛事记录 · 按时间倒序 · 共 {tournaments.length} 项</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <a href="/baseball/" class="back-link">← 返回训练与比赛</a>

      <div class="t-list">
        {sortedTournaments.map((t) => {
          const badge = placeBadge(t.place, t.status);
          const d = formatDate(t.date);
          return (
            <article class={`t-item t-item--${t.status} ${t.place === 1 ? 't-item--champion' : ''}`}>
              <div class="t-item__left">
                <div class="t-item__date">
                  <span class="t-item__year">{d.y}</span>
                  <span class="t-item__month">{d.m}</span>
                </div>
                <span class={`t-badge ${badge.cls}`} title={badge.label}>
                  <span class="t-badge__icon">{badge.icon}</span>
                  <span class="t-badge__label">{t.status === 'upcoming' ? '待定' : (t.place ? `第${t.place}名` : '小组赛')}</span>
                </span>
              </div>
              <div class="t-item__main">
                <h3 class="t-item__title">{t.name}</h3>
                <p class="t-item__meta">
                  <span>📍 {t.location}</span>
                  {t.category && <span> · {t.category}</span>}
                  <span> · <span class={`level-tag level-tag--${t.level === '国家级' ? 'national' : 'provincial'}`}>{t.level}</span></span>
                </p>
                {t.note && <p class="t-item__note">⚠️ {t.note}</p>}
              </div>
              <div class="t-item__right">
                <span class="t-item__team">{t.team}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .t-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .t-item {
    display: grid;
    grid-template-columns: 110px 1fr 180px;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .t-item:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .t-item--champion {
    border-color: rgba(255, 215, 0, 0.4);
    background: linear-gradient(135deg, var(--color-bg-card) 0%, rgba(255, 215, 0, 0.06) 100%);
  }

  .t-item--upcoming {
    border-style: dashed;
    border-color: rgba(0, 212, 170, 0.4);
    background: linear-gradient(135deg, var(--color-bg-card) 0%, rgba(0, 212, 170, 0.04) 100%);
  }

  .t-item__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .t-item__date {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .t-item__year {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: 600;
  }

  .t-item__month {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .t-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px var(--space-sm);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    white-space: nowrap;
  }

  .t-badge__icon {
    font-size: 1rem;
    line-height: 1;
  }

  .t-badge__label {
    font-variant-numeric: tabular-nums;
  }

  .t-badge--gold {
    background: rgba(255, 215, 0, 0.18);
    color: #FFD700;
    border: 1px solid rgba(255, 215, 0, 0.35);
  }

  .t-badge--silver {
    background: rgba(192, 192, 192, 0.18);
    color: #E0E0E0;
    border: 1px solid rgba(192, 192, 192, 0.35);
  }

  .t-badge--bronze {
    background: rgba(205, 127, 50, 0.18);
    color: #CD7F32;
    border: 1px solid rgba(205, 127, 50, 0.35);
  }

  .t-badge--top8 {
    background: rgba(99, 102, 241, 0.18);
    color: #818CF8;
    border: 1px solid rgba(99, 102, 241, 0.35);
  }

  .t-badge--group {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
  }

  .t-badge--upcoming {
    background: rgba(0, 212, 170, 0.15);
    color: var(--color-accent);
    border: 1px dashed rgba(0, 212, 170, 0.4);
  }

  .t-badge--plain {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
  }

  .t-item__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .t-item__meta {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    align-items: center;
  }

  .t-item__note {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: #FFB347;
    font-style: italic;
  }

  .t-item__right {
    text-align: right;
  }

  .t-item__team {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    background: rgba(255, 107, 53, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .level-tag {
    display: inline-block;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .level-tag--national {
    background: rgba(255, 107, 53, 0.18);
    color: var(--color-primary);
  }

  .level-tag--provincial {
    background: rgba(0, 212, 170, 0.18);
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .t-item {
      grid-template-columns: 80px 1fr;
      gap: var(--space-md);
    }

    .t-item__right {
      grid-column: 2;
      text-align: left;
      margin-top: var(--space-xs);
    }
  }

  @media (max-width: 480px) {
    .t-item {
      grid-template-columns: 1fr;
      padding: var(--space-md);
    }

    .t-item__left {
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
    }

    .t-item__date {
      flex-direction: row;
      gap: var(--space-xs);
    }
  }
</style>
