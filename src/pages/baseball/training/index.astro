---
import BaseLayout from '@layouts/BaseLayout.astro';
import trainingsData from '../../../../data/trainings.json';

type TrainingType = 'camp' | 'self' | 'gameDay' | 'daily';

interface Training {
  start: string;
  end: string;
  title: string;
  type: TrainingType;
  gain: string;
}

const typeMeta: Record<TrainingType, { label: string; icon: string; cls: string }> = {
  camp: { label: '集训', icon: '🏕️', cls: 't-badge--camp' },
  self: { label: '自主训练', icon: '🏃', cls: 't-badge--self' },
  gameDay: { label: '比赛日', icon: '🏟️', cls: 't-badge--gameday' },
  daily: { label: '日常训练', icon: '⚾', cls: 't-badge--daily' },
};

// 记录日期统一为 YYYY.M.D
const parseDate = (d: string) => {
  const [y, m, day] = d.split('.').map(Number);
  return new Date(y, m - 1, day).getTime();
};
const monthKey = (d: string) => d.split('.').slice(0, 2).join('.');
const isDateRange = (end: string) => end.includes('.');

const trainings = (trainingsData as Training[])
  .slice()
  .sort((a, b) => parseDate(b.start) - parseDate(a.start));

// 单次训练时长（小时）；集训按自然日计算
const hoursOf = (t: Training) => {
  if (isDateRange(t.end)) return 0;
  const m = t.end.match(/^(\d+(?:\.\d+)?)/);
  return m ? Number(m[1]) : 0;
};
const daysOf = (t: Training) => {
  if (!isDateRange(t.end)) return 0;
  return Math.round((parseDate(t.end) - parseDate(t.start)) / 86400000) + 1;
};

// 概览统计
const totalHours = trainings.reduce((s, t) => s + hoursOf(t), 0);
const totalCampDays = trainings.reduce((s, t) => s + daysOf(t), 0);
const venues = new Set(trainings.map((t) => t.title)).size;
const months = Array.from(new Set(trainings.map((t) => monthKey(t.start))))
  .sort((a, b) => parseDate(`${b}.1`) - parseDate(`${a}.1`));
const firstMonth = months[months.length - 1].split('.');
const lastMonth = months[0].split('.');

// 类型筛选（含计数）
const typeOrder: TrainingType[] = ['camp', 'self', 'gameDay', 'daily'];
const typeFilters = typeOrder.map((key) => ({
  key,
  ...typeMeta[key],
  count: trainings.filter((t) => t.type === key).length,
}));

// 按月份分组（倒序）
const groups = months.map((key) => {
  const items = trainings.filter((t) => monthKey(t.start) === key);
  const [y, m] = key.split('.');
  return {
    key,
    label: `${y}年${parseInt(m)}月`,
    count: items.length,
    hours: items.reduce((s, t) => s + hoursOf(t), 0),
    items,
  };
});
---

<BaseLayout title="训练日志 | Max Liu" description="Max 的真实棒球训练记录与心得">
  <section class="page-hero page-hero--baseball">
    <div class="container">
      <div class="page-hero__badge">⚾ BASEBALL</div>
      <h1 class="page-hero__title">训练日志</h1>
      <p class="page-hero__desc">
        真实训练记录 · 从集训到日常 · {firstMonth[0]}.{parseInt(firstMonth[1])} - {lastMonth[0]}.{parseInt(lastMonth[1])} · 共 {trainings.length} 条
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <a href="/baseball/" class="back-link">← 返回训练与比赛</a>

      <!-- 训练概览 -->
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">{trainings.length}</span>
          <span class="stat-card__label">训练场次</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{totalHours}<small>小时</small></span>
          <span class="stat-card__label">累计时长</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{totalCampDays}<small>天</small></span>
          <span class="stat-card__label">集训周期</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{venues}</span>
          <span class="stat-card__label">训练场地</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{months.length}<small>个月</small></span>
          <span class="stat-card__label">训练跨度</span>
        </div>
      </div>

      <div data-training-log>
        <!-- 类型筛选 -->
        <div class="filter-bar">
          <div class="filter-group">
            <button class="filter-btn is-active" data-filter="all" aria-pressed="true">全部</button>
            {typeFilters.map((f) => (
              <button class="filter-btn" data-filter={f.key} aria-pressed="false">
                {f.icon} {f.label} <span class="filter-btn__count">{f.count}</span>
              </button>
            ))}
          </div>
          <span class="filter-count">显示 <strong data-visible-count>{trainings.length}</strong> / {trainings.length} 场</span>
        </div>

        <!-- 按月分组 -->
        {groups.map((g) => (
          <div class="month-group" data-group>
            <div class="month-head">
              <h2 class="month-head__title">{g.label}</h2>
              <span class="month-head__meta">
                {g.count} 场{g.hours > 0 && ` · ${g.hours} 小时`}
              </span>
            </div>
            <div class="training-list">
              {g.items.map((t) => (
                <article class="training-item" data-type={t.type}>
                  <div class="training-item__date">
                    <time class="training-item__start">{t.start}</time>
                    <span class="training-item__end">
                      {isDateRange(t.end) ? `→ ${t.end}` : `· ${t.end}`}
                    </span>
                    {isDateRange(t.end) && (
                      <span class="training-item__days">共 {daysOf(t)} 天</span>
                    )}
                  </div>
                  <div class="training-item__main">
                    <div class="training-item__top">
                      <h3 class="training-item__title">{t.title}</h3>
                      <span class={`t-badge ${typeMeta[t.type].cls}`}>
                        {typeMeta[t.type].icon} {typeMeta[t.type].label}
                      </span>
                    </div>
                    <p class="training-item__content">{t.gain}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector('[data-training-log]');
  const buttons = root?.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = root?.querySelectorAll<HTMLElement>('[data-type]');
  const groups = root?.querySelectorAll<HTMLElement>('[data-group]');
  const counter = root?.querySelector<HTMLElement>('[data-visible-count]');

  buttons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      items?.forEach((el) => {
        const show = type === 'all' || el.dataset.type === type;
        el.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      groups?.forEach((group) => {
        group.classList.toggle('is-hidden', !group.querySelector('[data-type]:not(.is-hidden)'));
      });
      if (counter) counter.textContent = String(visible);
    });
  });
</script>

<style>
  /* 概览统计 */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg) var(--space-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .stat-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .stat-card__value {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stat-card__value small {
    font-size: var(--text-xs);
    font-weight: 600;
    margin-left: 2px;
    color: var(--text-muted);
  }

  .stat-card__label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* 筛选栏 */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    font-size: var(--text-xs);
    font-family: inherit;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--color-border-hover);
  }

  .filter-btn.is-active {
    color: var(--color-secondary);
    background: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 700;
  }

  .filter-btn__count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .filter-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .filter-count strong {
    color: var(--color-primary);
    font-size: var(--text-sm);
  }

  /* 月份分组 */
  .month-group + .month-group {
    margin-top: var(--space-xl);
  }

  .month-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .month-head__title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--text-primary);
  }

  .month-head__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 训练条目 */
  .training-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .training-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .training-item:hover {
    border-color: var(--color-border-hover);
  }

  .training-item__date {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .training-item__start {
    font-weight: 800;
    color: var(--color-primary);
    font-size: var(--text-base);
    font-variant-numeric: tabular-nums;
  }

  .training-item__end {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .training-item__days {
    align-self: flex-start;
    padding: 2px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent);
    background: rgba(0, 212, 170, 0.1);
    border-radius: var(--radius-full);
  }

  .training-item__main {
    min-width: 0;
  }

  .training-item__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .training-item__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
  }

  .training-item__content {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* 类型徽章 */
  .t-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 10px;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .t-badge--camp {
    color: var(--color-baseball-red);
    background: rgba(196, 30, 58, 0.14);
  }

  .t-badge--self {
    color: #818CF8;
    background: rgba(129, 140, 248, 0.14);
  }

  .t-badge--gameday {
    color: #FBBF24;
    background: rgba(251, 191, 36, 0.14);
  }

  .t-badge--daily {
    color: var(--color-accent);
    background: rgba(0, 212, 170, 0.12);
  }

  .is-hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .stat-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .training-item {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  @media (max-width: 480px) {
    .stat-grid {
      grid-template-columns: 1fr 1fr;
    }

    .filter-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
